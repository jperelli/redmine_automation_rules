<% html_title l(:label_automation_rules), @rule.name, l(:button_edit) %>
<h2>
  <%= link_to l(:label_automation_rules), automation_rules_index_path_for(@project) %> &#187;
  <%= link_to @rule.name, automation_rule_path_for(@rule) %> &#187;
  <%= l(:button_edit) %>
</h2>

<%= labelled_form_for @rule, url: automation_rule_path_for(@rule), html: { id: 'automation-rule-form', class: 'automation-rule-form', method: :put } do |f| %>
  <%= render partial: 'automation_rules/form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
<% end %>
