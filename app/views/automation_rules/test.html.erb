<% html_title l(:label_automation_rules), @rule.name, l(:automation_rules_button_test) %>

<h2>
  <%= link_to l(:label_automation_rules), automation_rules_index_path_for(@project) %> &#187;
  <%= link_to @rule.name, automation_rule_path_for(@rule) %> &#187;
  <%= l(:automation_rules_button_test) %>
</h2>

<div class="box">
  <p class="automation-rule-sentence"><%= @rule.sentence %></p>
  <%= render partial: 'automation_rules/test_form' %>
</div>

<% if @result %>
  <%= render partial: 'automation_rules/test_result', locals: { result: @result } %>
<% end %>

<%= render partial: 'automation_rules/credit' %>
